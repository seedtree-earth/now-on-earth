{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "now-on-earth/core": ["./src/core/index.ts"],
      "now-on-earth/mapbox": ["./src/mapbox/index.ts"],
      "now-on-earth/events/*": ["./events/*"]
    }
  },
  "include": ["src", "site/src", "site/vite.config.ts", "test", "tsup.config.ts"]
}
