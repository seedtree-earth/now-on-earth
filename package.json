{
  "name": "now-on-earth",
  "version": "0.1.0",
  "description": "A numberless solar clock on a 3D globe. Time told by light, not digits. Layers for Mapbox GL, plus the pure sun maths underneath.",
  "type": "module",
  "license": "MIT",
  "author": "SeedTree",
  "homepage": "https://github.com/seedtree-earth/now-on-earth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedtree-earth/now-on-earth.git"
  },
  "bugs": {
    "url": "https://github.com/seedtree-earth/now-on-earth/issues"
  },
  "keywords": [
    "solar-clock",
    "subsolar-point",
    "terminator",
    "day-night",
    "mapbox-gl",
    "globe",
    "seedtree"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./mapbox": {
      "types": "./dist/mapbox/index.d.ts",
      "import": "./dist/mapbox/index.js"
    },
    "./package.json": "./package.json",
    "./events/*": "./events/*"
  },
  "files": [
    "dist",
    "events",
    "DATA_SOURCES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "tsup",
    "build:site": "vite build --config site/vite.config.ts",
    "preview": "vite preview --config site/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:copy && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "data:humpbacks": "node scripts/ecology/humpbacks.mjs"
  },
  "peerDependencies": {
    "mapbox-gl": "^3.26.0"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "mapbox-gl": "3.26.0",
    "topojson-client": "^3.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "world-atlas": "^2.0.2"
  }
}
